# Inject via PHP-FPM/cPanel environment or export in the shell. PHP does NOT auto-load .env.
# Never store real values in this file or in public_html.
DATAGRAPH_ADMIN_PASSWORD=CHANGE_TO_UNIQUE_12_OR_MORE_CHAR_SECRET
DATAGRAPH_PRIVATE_DIR=/home/CPANEL_USER/datagraph-private
# Android signing is provided by GitHub Secrets, not this file:
# ANDROID_KEYSTORE_BASE64, ANDROID_STORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
