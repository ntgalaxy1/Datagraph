# DataGraph Production .htaccess for Main Domain (cPanel / DirectAdmin)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS automatically on live domain (skip on localhost)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow only the actual Android domain-verification document.
  RewriteRule ^\.well-known/assetlinks\.json$ - [L]

  # Block direct access to hidden files (such as data/.admin_secret.json)
  RewriteRule (^|/)\. - [F,L]

  # SPA Fallback to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Prevent browser caching of catalog.json so price updates appear immediately for all visitors
<FilesMatch "catalog\.json$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/json .json
  AddCharset UTF-8 .html .css .js .json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# Defense in depth: no direct access to secrets, temporary files or archives.
<FilesMatch "(^\.|\.(env|bak|zip|jks|keystore|pre-v2\.json)$|^backup-(lib|cli)\.php$)">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Inventory helpers and schemas are executable includes/operator inputs, not public APIs.
<FilesMatch "^(inventory-lib|sheets-lib|install-lib)\.php$|^schema\.sql$|^sheets-cron\.php$">
  Require all denied
</FilesMatch>
